{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-login.php", "destination": "/", "permanent": true },
    { "source": "/wp-content/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-includes/:path*", "destination": "/", "permanent": true },
    { "source": "/xmlrpc.php", "destination": "/", "permanent": true },
    { "source": "/our-people/:path*", "destination": "/", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/post-sitemap.xml", "destination": "/", "permanent": true },
    { "source": "/post-sitemap1.xml", "destination": "/", "permanent": true },
    { "source": "/posts-sitemap.xml", "destination": "/", "permanent": true },
    { "source": "/posts-sitemap1.xml", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ]
}
